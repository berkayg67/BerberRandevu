# Bu dosyayı kopyalayıp adını .env.local yapın ve değerleri doldurun.
# .env.local Git'e gönderilmez; bu örnek dosya gönderilir.

# Uygulamanın kullandığı bağlantı: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.PROJE_KODU:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Tabloları kurarken kullanılan bağlantı: Supabase → Connect → Session pooler (port 5432)
DATABASE_URL_DIRECT="postgresql://postgres.PROJE_KODU:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
